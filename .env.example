# Copie para .env na raiz do projeto:
#   cp .env.example .env
#
# O Django carrega este arquivo via python-dotenv (ouvidoria_backend/settings.py).
# Nunca commite o arquivo .env (ele está no .gitignore).

# --- Django ---
# Gere uma chave nova em dev: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=altere-me-use-uma-chave-segura

# Usado em produção no servidor; em settings.py o DEBUG ainda está fixo em True — ajuste lá ou evolua settings para ler esta variável.
DEBUG=True

# Lista separada por vírgulas (referência; ALLOWED_HOSTS hoje está definido em settings.py).
ALLOWED_HOSTS=ouvidoria.mogidascruzes.sp.gov.br,localhost,127.0.0.1

# --- Banco de dados (MySQL) ---
# Em settings.py: NAME, USER e HOST estão fixos (ouvidoria_db / ouvidoria_user / localhost).
# Apenas a senha vem do ambiente.
DB_NAME=ouvidoria_db
DB_USER=ouvidoria_user
DB_PASSWORD=senha-do-mysql
DB_HOST=localhost
DB_PORT=3306

# --- E-mail (SMTP Mailgrid) ---
# Usado para envio de pesquisas de satisfação (comando enviar_pesquisas e admin).
SMTP_USER=seu-usuario@smtp.exemplo.gov.br
SMTP_PASSWORD=senha-ou-app-password-smtp

# --- API Colab (integração) ---
# Obrigatório para: python manage.py sincronizar_colab
# e python manage.py gerar_relatorio_colab
COLAB_APP_ID=00000000-0000-0000-0000-000000000000
COLAB_API_KEY=00000000-0000-0000-0000-000000000000
COLAB_USER_TOKEN=00000000-0000-0000-0000-000000000000
